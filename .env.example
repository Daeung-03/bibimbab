LINER_API_KEY=
LINER_MODEL=liner-mark-1.1

# Frontend: leave blank for local Vite; deployed Pages uses the HTTPS API origin.
VITE_API_BASE_URL=
# Frontend: use /repository-name/ for a GitHub project page; / for a custom domain.
VITE_BASE_PATH=/

# API server: comma-separated frontend origins, without paths or trailing slashes.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
PORT=8787
